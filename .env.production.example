# Production app URL
NEXTAUTH_URL="https://your-domain.example"

# Change this to a long random secret before going live
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Encrypts staff two-factor (TOTP) secrets at rest: openssl rand -base64 32
# Keep it with your other secrets and back it up. If it is lost or
# changed, every staff member must set up two-factor authentication again.
MFA_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# Emailed on every Super Admin sign-in (break-glass alert to the board).
SECURITY_ALERT_EMAIL="board@your-domain.example"

# PostgreSQL connection string for production
DATABASE_URL="postgresql://mcfinance:change-me@postgres:5432/mcfinance?schema=public"

# Optional email settings
RESEND_API_KEY="re_your_key_here"
ADMIN_EMAIL="your@email.com"
EMAIL_FROM="Millionaires Club <noreply@your-domain.example>"
ADMIN_SEED_EMAIL="admin@mcfinance.local"
SUPPORT_EMAIL="support@mcfinance.local"

# ── Online payments (member portal) ────────────────────────
# Use LIVE keys here, not test keys. STRIPE_WEBHOOK_SECRET comes from
# the webhook endpoint you create in the Stripe dashboard pointing at
# https://your-domain.example/api/webhooks/stripe
STRIPE_SECRET_KEY="sk_live_your_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_secret_here"

# Zelle has no payment API — these just control what instructions are
# shown to members; a Zelle "payment" is always confirmed manually by
# an admin against the club's actual bank activity.
NEXT_PUBLIC_ZELLE_RECIPIENT_NAME="Millionaires Club"
NEXT_PUBLIC_ZELLE_RECIPIENT_EMAIL="payments@your-domain.example"

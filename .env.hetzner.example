# Copy to .env (next to docker-compose.hetzner.yml). Docker Compose reads it
# automatically, so these survive reboots and new SSH sessions.

# The address the club uses for the admin panel. Its DNS A record must
# point at this server before the first start, so Caddy can get a certificate.
DOMAIN=admin.your-domain.example

# Database password: openssl rand -hex 24
# Use the same value in DATABASE_URL in .env.production. It only takes
# effect when the database is first created; to change it later, see the
# deploy guide.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

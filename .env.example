# -------------------------------------------------------
# COPY THIS FILE to .env.local  (setup.sh does this for you)
# No database installation needed — uses a local SQLite file
# -------------------------------------------------------

# SQLite database — stored as a file inside the project
DATABASE_URL="file:./dev.db"

# Secret for login sessions (ready to use, change before going live)
NEXTAUTH_SECRET="mc-secret-change-before-going-live-xK9pL2mN8qR"

# Password used only when seeding the initial admin account
ADMIN_SEED_PASSWORD="change-this-before-setup"

# URL of your app
NEXTAUTH_URL="http://localhost:3000"

# ── Email notifications (Phase 4) ──────────────────────────
# Sign up free at resend.com — no credit card, 3000 emails/month
RESEND_API_KEY="re_your_key_here"

# Where admin summary emails get sent
ADMIN_EMAIL="your@email.com"
